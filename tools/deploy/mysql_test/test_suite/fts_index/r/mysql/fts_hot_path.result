DROP DATABASE IF EXISTS fts_hot_path;
CREATE DATABASE fts_hot_path;
USE fts_hot_path;
SET NAMES utf8mb4;
SET ob_query_timeout = 10000000000;
SELECT tokenize('Database DATABASE database audit audit', 'space', '[{"output":"all"}]') AS tokens;
tokens
{"tokens": [{"audit": 2}, {"database": 3}], "doc_len": 5}
SELECT tokenize('Database DATABASE database audit audit', 'beng', '[{"output":"all"}]') AS tokens;
tokens
{"tokens": [{"audit": 2}, {"database": 3}], "doc_len": 5}
SELECT tokenize('数据库 数据库 全文索引 OceanBase OCEANBASE 123 １２３ ＡＢＣ abc', 'ik', '[{"output":"all"}]') AS tokens;
tokens
{"tokens": [{"123": 1}, {"oceanbase": 2}, {"１２３": 1}, {"数据库": 2}, {"abc": 1}, {"ａｂｃ": 1}, {"全文索引": 1}], "doc_len": 9}
SELECT tokenize('中华人民共和国人民大会堂', 'ik', '[{"output":"all"},{"additional_args":[{"ik_mode":"smart"}]}]') AS tokens;
tokens
{"tokens": [{"人民大会堂": 1}, {"中华人民共和国": 1}], "doc_len": 2}
SELECT tokenize('中华人民共和国人民大会堂', 'ik', '[{"output":"all"},{"additional_args":[{"ik_mode":"max_word"}]}]') AS tokens;
tokens
{"tokens": [{"大会": 1}, {"人民大会堂": 1}, {"大会堂": 1}, {"共和国": 1}, {"人民大会": 1}, {"人民共和国": 1}, {"中华人民": 1}, {"共和": 1}, {"会堂": 1}, {"中华": 1}, {"中华人民共和国": 1}, {"国人": 1}, {"华人": 1}, {"人民": 2}], "doc_len": 15}
SELECT tokenize('中文 かな カナ 한글 😀 𠀀 ，。！？ A1.2-test@example.com', 'ik', '[{"output":"all"}]') AS tokens;
tokens
{"tokens": [{"な": 1}, {"ナ": 1}, {"한": 1}, {"カ": 1}, {"글": 1}, {"か": 1}, {"中文": 1}, {"a1.2-test@example.com": 1}], "doc_len": 8}
SELECT tokenize(CONCAT('hello', CHAR(0), 'world', CHAR(9), 'database'), 'beng', '[{"output":"all"}]') AS tokens;
tokens
{"tokens": [{"hello": 1}, {"database": 1}, {"world": 1}], "doc_len": 3}
SELECT tokenize('the and database database', 'space', '[{"output":"all"}]') AS tokens;
tokens
{"tokens": [{"database": 2}, {"and": 1}], "doc_len": 3}
SELECT tokenize(_utf8mb4'café cafe CAFÉ' COLLATE utf8mb4_general_ci, 'space', '[{"output":"all"}]') AS tokens;
tokens
{"tokens": [{"café": 3}], "doc_len": 3}
SELECT tokenize(_utf8mb4'café cafe CAFÉ' COLLATE utf8mb4_bin, 'space', '[{"output":"all"}]') AS tokens;
tokens
{"tokens": [{"café": 2}, {"cafe": 1}], "doc_len": 3}
SELECT tokenize('', 'ik', '[{"output":"all"}]') AS tokens;
tokens
{"tokens": [], "doc_len": 0}
SELECT tokenize(NULL, 'beng', '[{"output":"all"}]') AS tokens;
tokens
{"tokens": [], "doc_len": 0}
SELECT tokenize('   ，。！？', 'ik', '[{"output":"all"}]') AS tokens;
tokens
{"tokens": [], "doc_len": 0}
SELECT tokenize('lowercase 1234 MixedCase CAFÉ café a-b a_b', 'beng', '[{"output":"all"}]') AS tokens;
tokens
{"tokens": [{"café": 2}, {"lowercase": 1}, {"1234": 1}, {"mixedcase": 1}], "doc_len": 5}
