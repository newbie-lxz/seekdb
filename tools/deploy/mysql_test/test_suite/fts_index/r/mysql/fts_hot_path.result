SELECT tokenize('hello hello world', 'ngram', '[{"output":"all"}]') AS tokens;
tokens
{"tokens": [{"lo": 2}, {"he": 2}, {"ll": 2}, {"or": 1}, {"rl": 1}, {"wo": 1}, {"ld": 1}, {"el": 2}], "doc_len": 12}
SELECT tokenize('一二三四 一二三四', 'ngram2', '[{"output":"all"},{"additional_args":[{"min_ngram_size":2},{"max_ngram_size":4}]}]') AS tokens;
tokens
{"tokens": [{"一二三": 2}, {"三四": 2}, {"二三": 2}, {"一二": 2}, {"一二三四": 2}, {"二三四": 2}], "doc_len": 12}
CREATE TABLE docs (
id INT PRIMARY KEY,
cn TEXT,
en TEXT,
FULLTEXT INDEX cn_idx(cn) WITH PARSER ik,
FULLTEXT INDEX en_idx(en) WITH PARSER beng
) DEFAULT CHARSET=utf8mb4;
INSERT INTO docs VALUES
(1, '数据库 数据库 全文索引', 'Database database performance audit'),
(2, '数据库 查询 优化', 'database query optimization'),
(3, '全文索引 分词器', 'full text indexing audit'),
(4, '没有匹配的文档', 'unrelated document');
SELECT id, ROUND(MATCH(cn) AGAINST('数据库'), 8) AS score FROM docs WHERE MATCH(cn) AGAINST('数据库') ORDER BY id;
id	score
