SELECT id FROM (SELECT id, MATCH(en) AGAINST('database audit') AS score FROM docs) t WHERE score > 0 ORDER BY score DESC, id;
--error ER_WRONG_ARGUMENTS
SELECT d.id FROM docs d WHERE MATCH(d.en) AGAINST('database audit') AND EXISTS (SELECT 1 FROM docs x WHERE x.id=d.id AND MATCH(d.en) AGAINST('database audit') > 0.5) ORDER BY d.id;
DELETE FROM docs WHERE id >= 6;
UPDATE docs SET cn='全文索引 分词器', en='audit audit audit' WHERE id=2;
DELETE FROM docs WHERE id=1;
INSERT INTO docs VALUES (5, '数据库 全文索引', 'database database audit');
SELECT id, ROUND(MATCH(cn) AGAINST('数据库'), 8) AS score FROM docs WHERE MATCH(cn) AGAINST('数据库') ORDER BY id;
SELECT id, ROUND(MATCH(en) AGAINST('database audit'), 8) AS score FROM docs WHERE MATCH(en) AGAINST('database audit') ORDER BY id;
SELECT id FROM docs WHERE MATCH(cn) AGAINST('全文索引 分词器') ORDER BY id;
