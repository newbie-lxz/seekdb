# Top-k must retain IDs, scores and ties when traversing all posting heads.
INSERT INTO docs VALUES (10, NULL, 'audit audit'), (11, NULL, 'performance audit'),
  (12, NULL, 'database database database'), (13, NULL, 'database audit performance audit');
SELECT id, ROUND(MATCH(en) AGAINST('database audit'), 8) AS score FROM docs WHERE MATCH(en) AGAINST('database audit') LIMIT 3;
SELECT id, ROUND(MATCH(en) AGAINST('audit database'), 8) AS score FROM docs WHERE MATCH(en) AGAINST('audit database') LIMIT 3;
SELECT id, ROUND(MATCH(en) AGAINST('database audit performance'), 8) AS score FROM docs WHERE MATCH(en) AGAINST('database audit performance') LIMIT 3 OFFSET 2;
SELECT id FROM docs WHERE MATCH(en) AGAINST('database missingtoken') LIMIT 1;
SELECT id FROM docs WHERE MATCH(en) AGAINST('+database -audit' IN BOOLEAN MODE) LIMIT 3;
SELECT id FROM docs WHERE MATCH(en) AGAINST('database audit') LIMIT 0;
SELECT id FROM docs WHERE MATCH(en) AGAINST('database audit') LIMIT 30;
PREPARE fts_topk FROM 'SELECT id, ROUND(MATCH(en) AGAINST(?), 8) FROM docs WHERE MATCH(en) AGAINST(?) LIMIT ?';
SET @q='database audit', @k=2;
EXECUTE fts_topk USING @q, @q, @k;
SET @q='performance audit', @k=4;
EXECUTE fts_topk USING @q, @q, @k;
SET @q='database audit', @k=2;
EXECUTE fts_topk USING @q, @q, @k;
DEALLOCATE PREPARE fts_topk;
DELETE FROM docs WHERE id=13;
UPDATE docs SET en='performance performance audit' WHERE id=12;
SELECT id, ROUND(MATCH(en) AGAINST('database audit performance'), 8) AS score FROM docs WHERE MATCH(en) AGAINST('database audit performance') LIMIT 3;
DROP DATABASE fts_hot_path;
