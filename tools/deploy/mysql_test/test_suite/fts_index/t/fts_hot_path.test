# owner: newbie-lxz
# description: Preserve IK classification and shared token frequency aggregation.
--disable_warnings
DROP DATABASE IF EXISTS fts_hot_path;
--enable_warnings
CREATE DATABASE fts_hot_path;
USE fts_hot_path;
SET NAMES utf8mb4;
SET ob_query_timeout = 10000000000;

# Full output checks both word frequencies and document length.
SELECT tokenize('Database DATABASE database audit audit', 'space', '[{"output":"all"}]') AS tokens;
SELECT tokenize('Database DATABASE database audit audit', 'beng', '[{"output":"all"}]') AS tokens;
SELECT tokenize('数据库 数据库 全文索引 OceanBase OCEANBASE 123 １２３ ＡＢＣ abc', 'ik', '[{"output":"all"}]') AS tokens;
SELECT tokenize('中华人民共和国人民大会堂', 'ik', '[{"output":"all"},{"additional_args":[{"ik_mode":"smart"}]}]') AS tokens;
SELECT tokenize('中华人民共和国人民大会堂', 'ik', '[{"output":"all"},{"additional_args":[{"ik_mode":"max_word"}]}]') AS tokens;
SELECT tokenize('中文 かな カナ 한글 😀 𠀀 ，。！？ A1.2-test@example.com', 'ik', '[{"output":"all"}]') AS tokens;
SELECT tokenize(CONCAT('hello', CHAR(0), 'world', CHAR(9), 'database'), 'beng', '[{"output":"all"}]') AS tokens;
SELECT tokenize('the and database database', 'space', '[{"output":"all"}]') AS tokens;
SELECT tokenize(_utf8mb4'café cafe CAFÉ' COLLATE utf8mb4_general_ci, 'space', '[{"output":"all"}]') AS tokens;
SELECT tokenize(_utf8mb4'café cafe CAFÉ' COLLATE utf8mb4_bin, 'space', '[{"output":"all"}]') AS tokens;
SELECT tokenize('', 'ik', '[{"output":"all"}]') AS tokens;
SELECT tokenize(NULL, 'beng', '[{"output":"all"}]') AS tokens;
SELECT tokenize('   ，。！？', 'ik', '[{"output":"all"}]') AS tokens;
SELECT tokenize('lowercase 1234 MixedCase CAFÉ café a-b a_b', 'beng', '[{"output":"all"}]') AS tokens;
--error ER_WRONG_PARAMETERS_TO_NATIVE_FCT
SELECT tokenize(_latin1'THE the database DATABASE', 'beng', '[{"output":"all"}]') AS tokens;
--error ER_WRONG_PARAMETERS_TO_NATIVE_FCT
SELECT tokenize(_latin1'the and database DATABASE', 'space', '[{"output":"all"}]') AS tokens;
# More than sixteen disjoint chains exercises the arbitrator array spill.
SELECT SHA2(CAST(tokenize(REPEAT('数据库 OceanBase 全文索引 123 ', 10), 'ik', '[{"output":"all"}]') AS CHAR), 256) AS tokens_digest;
SELECT SHA2(CAST(tokenize(REPEAT('中华人民共和国人民大会堂 ', 10), 'ik', '[{"output":"all"},{"additional_args":[{"ik_mode":"smart"}]}]') AS CHAR), 256) AS tokens_digest;
SELECT SHA2(CAST(tokenize(REPEAT('中华人民共和国人民大会堂 ', 10), 'ik', '[{"output":"all"},{"additional_args":[{"ik_mode":"max_word"}]}]') AS CHAR), 256) AS tokens_digest;
SELECT tokenize('hello hello world', 'ngram', '[{"output":"all"}]') AS tokens;
SELECT tokenize('一二三四 一二三四', 'ngram2', '[{"output":"all"},{"additional_args":[{"min_ngram_size":2},{"max_ngram_size":4}]}]') AS tokens;

# Configuration reuse must preserve per-row parser and property changes.
CREATE TABLE parser_props (id INT PRIMARY KEY, parser_name VARCHAR(16), config TEXT);
INSERT INTO parser_props VALUES
 (1,'beng','[{"output":"all"},{"additional_args":[{"min_token_size":1},{"max_token_size":10}]}]'),
 (2,'beng','[{"output":"all"},{"additional_args":[{"min_token_size":1},{"max_token_size":10}]}]'),
 (3,'beng','[{"output":"all"}]'),
 (4,'ik','[{"output":"all"},{"additional_args":[{"ik_mode":"max_word"}]}]'),
 (5,'ik','[{"output":"all"},{"additional_args":[{"ik_mode":"max_word"}]}]'),
 (6,'ik','[{"output":"all"},{"additional_args":[{"ik_mode":"smart"}]}]'),
 (7,'space','[{"output":"all"},{"additional_args":[{"min_token_size":2},{"max_token_size":10}]}]'),
 (8,'beng','[{"output":"all"}]'),
 (9,'ik','[{"output":"all"},{"additional_args":[{"ik_mode":"max_word"}]}]'),
 (10,'beng','[{"output":"all"},{"additional_args":[{"min_token_size":1},{"max_token_size":10}]}]');
SELECT id, tokenize('中华人民共和国人民大会堂 Database abc ab 123 the', parser_name, config) AS tokens FROM parser_props ORDER BY id;
DROP TABLE parser_props;
--error ER_WRONG_ARGUMENTS
SELECT tokenize('database', 'beng', '[{"additional_args":[{"min_token_size":0}]}]');
--error ER_WRONG_ARGUMENTS
SELECT tokenize('database', 'beng', '[{"additional_args":[{"min_token_size":0}]}]');

CREATE TABLE docs (
  id INT PRIMARY KEY,
  cn TEXT,
  en TEXT,
  FULLTEXT INDEX cn_idx(cn) WITH PARSER ik,
  FULLTEXT INDEX en_idx(en) WITH PARSER beng
) DEFAULT CHARSET=utf8mb4;
INSERT INTO docs VALUES
  (1, '数据库 数据库 全文索引', 'Database database performance audit'),
  (2, '数据库 查询 优化', 'database query optimization'),
  (3, '全文索引 分词器', 'full text indexing audit'),
  (4, '没有匹配的文档', 'unrelated document');
# Verify document identity and relevance, including repeated terms.
SELECT id, ROUND(MATCH(cn) AGAINST('数据库'), 8) AS score FROM docs WHERE MATCH(cn) AGAINST('数据库') ORDER BY id;
SELECT id, ROUND(MATCH(en) AGAINST('database audit'), 8) AS score FROM docs WHERE MATCH(en) AGAINST('database audit') ORDER BY id;
SELECT id FROM docs WHERE MATCH(cn) AGAINST('全文索引 分词器') ORDER BY id;
SELECT id FROM docs WHERE MATCH(en) AGAINST('DATABASE') ORDER BY id;
SELECT id FROM docs WHERE MATCH(en) AGAINST('+database -audit' IN BOOLEAN MODE) ORDER BY id;
SELECT id FROM docs WHERE MATCH(cn) AGAINST('数据库 数据库') ORDER BY id;
SELECT id FROM docs WHERE MATCH(en) AGAINST('missingtoken') ORDER BY id;
SELECT id FROM docs WHERE MATCH(en) AGAINST('') ORDER BY id;
# Relevance can be omitted only when every use observes membership.
INSERT INTO docs VALUES (6, NULL, NULL), (7, '', ''), (8, '数据库', 'database');
SELECT COUNT(*) FROM docs WHERE MATCH(en) AGAINST('database audit');
SELECT id FROM docs WHERE MATCH(en) AGAINST('database audit') > 0 ORDER BY id;
SELECT id FROM docs WHERE 0 < MATCH(en) AGAINST('database audit') ORDER BY id;
SELECT id FROM docs WHERE MATCH(en) AGAINST('database audit') AND id > 1 ORDER BY id;
SELECT id FROM docs WHERE MATCH(en) AGAINST('database audit') OR id=4 ORDER BY id;
SELECT id FROM docs WHERE NOT MATCH(en) AGAINST('database audit') ORDER BY id;
SELECT id, ROUND(MATCH(en) AGAINST('database audit'), 8) AS score FROM docs WHERE MATCH(en) AGAINST('database audit') ORDER BY score DESC, id;
SELECT id FROM docs WHERE MATCH(en) AGAINST('database audit') ORDER BY MATCH(en) AGAINST('database audit') DESC, id;
SELECT id FROM docs WHERE MATCH(en) AGAINST('database audit') > 0.5 ORDER BY id;
SELECT id FROM docs WHERE MATCH(en) AGAINST('database audit') = 1 ORDER BY id;
SELECT id FROM docs WHERE MATCH(en) AGAINST('database audit') <= 0 ORDER BY id;
SELECT id FROM docs WHERE MATCH(en) AGAINST('database audit') IS NULL ORDER BY id;
SELECT id, ROUND(MATCH(en) AGAINST('audit database performance'), 8) AS score FROM docs WHERE MATCH(en) AGAINST('audit database performance') ORDER BY id;
SELECT id, ROUND(MATCH(en) AGAINST('database performance audit'), 8) AS score FROM docs WHERE MATCH(en) AGAINST('database performance audit') ORDER BY id;
SELECT COUNT(*) FROM docs WHERE MATCH(en) AGAINST('database missingtoken');
SELECT COUNT(*) FROM docs WHERE MATCH(en) AGAINST('database audit missingtoken');
SELECT COUNT(*) FROM docs WHERE MATCH(en) AGAINST('database audit performance missingtoken');
SELECT id, MATCH(en) AGAINST('database audit') > 0 AS hit FROM docs ORDER BY id;
SELECT COUNT(*) FROM (SELECT id FROM docs WHERE MATCH(en) AGAINST('database audit') LIMIT 2 OFFSET 1) t;
SELECT id FROM docs WHERE MATCH(en) AGAINST('+database -audit' IN BOOLEAN MODE) ORDER BY id;
--error ER_SYNTAX_ERROR
SELECT id FROM docs WHERE MATCH(en) AGAINST('database ~audit' IN BOOLEAN MODE) ORDER BY id;
PREPARE fts_threshold FROM 'SELECT id FROM docs WHERE MATCH(en) AGAINST(?) > ? ORDER BY id';
SET @query='database audit', @threshold=0;
EXECUTE fts_threshold USING @query, @threshold;
SET @threshold=0.5;
EXECUTE fts_threshold USING @query, @threshold;
SET @threshold=0;
EXECUTE fts_threshold USING @query, @threshold;
DEALLOCATE PREPARE fts_threshold;
# A long query exercises the term-at-a-time iterator as well.
