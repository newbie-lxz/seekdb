matchedgf unmatchedgg unmatchedgh unmatchedgi unmatchedgj unmatchedgk unmatchedgl unmatchedgm unmatchedgn unmatchedgo unmatchedgp unmatchedgq unmatchedgr unmatchedgs unmatchedgt unmatchedgu unmatchedgv unmatchedgw unmatchedgx unmatchedgy unmatchedgz unmatchedha unmatchedhb unmatchedhc unmatchedhd unmatchedhe unmatchedhf unmatchedhg unmatchedhh unmatchedhi unmatchedhj unmatchedhk unmatchedhl unmatchedhm unmatchedhn unmatchedho unmatchedhp unmatchedhq unmatchedhr unmatchedhs unmatchedht unmatchedhu unmatchedhv unmatchedhw unmatchedhx unmatchedhy unmatchedhz unmatchedia unmatchedib unmatchedic unmatchedid unmatchedie unmatchedif unmatchedig unmatchedih unmatchedii unmatchedij unmatchedik unmatchedil unmatchedim unmatchedin unmatchedio unmatchedip unmatchediq unmatchedir unmatchedis unmatchedit unmatchediu unmatchediv unmatchediw unmatchedix unmatchediy unmatchediz unmatchedja unmatchedjb unmatchedjc unmatchedjd unmatchedje unmatchedjf unmatchedjg unmatchedjh unmatchedji unmatchedjj unmatchedjk unmatchedjl unmatchedjm unmatchedjn unmatchedjo unmatchedjp unmatchedjq unmatchedjr unmatchedjs unmatchedjt unmatchedju unmatchedjv unmatchedjw unmatchedjx unmatchedjy unmatchedjz unmatchedka unmatchedkb unmatchedkc unmatchedkd unmatchedke unmatchedkf unmatchedkg unmatchedkh unmatchedki unmatchedkj');
SELECT id FROM (SELECT id, MATCH(en) AGAINST('database audit') AS score FROM docs) t WHERE score > 0 ORDER BY score DESC, id;
--error ER_WRONG_ARGUMENTS
SELECT d.id FROM docs d WHERE MATCH(d.en) AGAINST('database audit') AND EXISTS (SELECT 1 FROM docs x WHERE x.id=d.id AND MATCH(d.en) AGAINST('database audit') > 0.5) ORDER BY d.id;
DELETE FROM docs WHERE id >= 6;
UPDATE docs SET cn='全文索引 分词器', en='audit audit audit' WHERE id=2;
DELETE FROM docs WHERE id=1;
INSERT INTO docs VALUES (5, '数据库 全文索引', 'database database audit');
SELECT id, ROUND(MATCH(cn) AGAINST('数据库'), 8) AS score FROM docs WHERE MATCH(cn) AGAINST('数据库') ORDER BY id;
SELECT id, ROUND(MATCH(en) AGAINST('database audit'), 8) AS score FROM docs WHERE MATCH(en) AGAINST('database audit') ORDER BY id;
SELECT id FROM docs WHERE MATCH(cn) AGAINST('全文索引 分词器') ORDER BY id;
DROP DATABASE fts_hot_path;
